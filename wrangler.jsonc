{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokemon-arena-multiplayer",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "b85beb35aba1c3bf54979eaacbd3d2a1",
  "workers_dev": true,
  "durable_objects": {"bindings": [
    {"name": "ROOMS", "class_name": "ArenaRoom"},
    {"name": "DIRECTORY", "class_name": "ArenaDirectory"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ArenaRoom", "ArenaDirectory"]}],
  "vars": {"ALLOWED_ORIGINS": "https://pokemon-arena-rosy.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"},
  "observability": {"enabled": false}
}
